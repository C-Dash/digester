# Virtual environment
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Build / packaging artifacts
dist/
build/
*.egg-info/
# ...but track our PyInstaller build config
*.spec
!cdash-digester.spec

# PyInstaller output
*.exe

# Test batch data (large, local only) — any number of leading X's, since
# these are commonly renamed to XCDB*/XXCDB*/XXXCDB*/... to temporarily
# "hide" a working copy from the scanner without moving it out of the repo.
CDB*/
X*CDB*/
X/

# Archives
*.zip

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
.DS_Store

# Logs
*.log

# Claude Code project memory
.claude/
